	option procd_boot_wan_timeout '60'
	option verbosity '2'
	option heartbeat_domain 'networkcheck.kde.org'
	option heartbeat_sleep_timeout '30'
	option dnsmasq_sanity_check '1'
	option sanity_check '1'
	option config_compat '18'
	option config_version '1.2.5-r3'
	option update_config_sizes '0'
	option dnsmasq_validity_check '1'
	option debug '1'

