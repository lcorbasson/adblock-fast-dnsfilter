#!/bin/sh
set -e
if (set -o pipefail 2>/dev/null); then
    set -o pipefail
fi

# Get the running script's filename
script_filename="$(readlink -f "$0")"

# Change to adblock-fast's working directory
cd /var/run/adblock-fast

# Log start time
start_time="$(date -Iseconds)"
echo "$start_time"

# Update
/etc/init.d/adblock-fast dl

# Save changes
git pull || true
cp -a "$script_filename" bin/ || true
git add bin/ || true
if [ -f dnsmasq.servers ]; then
	git add dnsmasq.servers || true
	echo "$start_time" | tee latest_successful_run.log
	git add latest_successful_run.log
else
	# If filters are missing, restore previous filters and reload dnsmasq
	git restore dnsmasq.servers || true
	/etc/init.d/dnsmasq reload
fi
git add uci/ || true

# Upload
git commit -m "$(date -I)"
git push -u origin main || true

# Log end time
date -Iseconds

